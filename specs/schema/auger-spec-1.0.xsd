<?xml version="1.0" encoding="UTF-8"?>
<!--
  auger XML specification grammar — schema version 1.0 (AUG-118, AUG-125, AUG-133).

  This file is the normative grammar for authored specs, and it is LOADED: `auger spec
  validate|check|list|assemble|bundle` all run the corpus loader, which loads this schema with a
  real XSD 1.0 processor and refuses any document it rejects (`schema-invalid`). Before AUG-125 this
  file was unloadable by every XSD 1.0 processor — two patterns were written in Python dialect
  (`(?:...)`), which a processor rejects outright — and before AUG-133 nothing loaded it even if it
  had been valid, so the "normative grammar" decided nothing.

  XSD 1.0 ONLY. No non-capturing groups `(?:`, no lookahead/lookbehind, no Python-only escapes:
  the processor refuses the whole schema when it meets one, which would take the entire gate down
  rather than one document. Patterns are also IMPLICITLY anchored over the lexical value, and `^`
  /`$` are ordinary characters in XSD 1.0, so the facets omit the anchors the Python constants in
  auger.py carry — the strings are otherwise identical, and tests/test_xsd_conformance.py pins the
  two engines to the same language with accepted/rejected samples.

  Design record: docs/SPEC-003-xml-specs.md. The XSD processor (lxml) is a `dev` / `auger[xsd]`
  dependency, never a runtime one: `pyproject.toml` keeps `dependencies = []`, and a host without
  the processor gets a typed refusal (`xsd-processor-missing`), not a silent pass.

  ch:trace row=AUG-118 spec=docs/SPEC-003-xml-specs.md#the-schema
  ch:trace row=AUG-125,AUG-133 spec=docs/SPEC-003-xml-specs.md#the-schema test=tests/test_xsd_conformance.py doc=docs/XML-SPEC-SCHEMA.md
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:auger="urn:auger:spec:1"
           targetNamespace="urn:auger:spec:1"
           elementFormDefault="qualified"
           attributeFormDefault="unqualified"
           version="1.0">

  <!-- A stable block ID: upper-case alphanumerics with at least one dash, never renumbered. -->
  <xs:simpleType name="stableId">
    <xs:restriction base="xs:string">
      <xs:pattern value="[A-Z][A-Z0-9]*(-[A-Z0-9]+)+"/>
      <xs:maxLength value="80"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- The block's own revision, independent of the document version. -->
  <xs:simpleType name="semanticVersion">
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9]+\.[0-9]+\.[0-9]+"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- An applicability scope token, e.g. auger.export. -->
  <xs:simpleType name="scopeToken">
    <xs:restriction base="xs:string">
      <xs:pattern value="[a-z0-9]+([._-][a-z0-9]+)*"/>
    </xs:restriction>
  </xs:simpleType>

  <!--
    The block kinds. `test` is here because the obligation validator enforces the <test> surface
    (runner/selector/path and the tracked-file checks), and a grammar that cannot express a shape
    the validator enforces is the defect AUG-133 names.
  -->
  <xs:simpleType name="blockKind">
    <xs:restriction base="xs:string">
      <xs:enumeration value="section"/>
      <xs:enumeration value="requirement"/>
      <xs:enumeration value="acceptance"/>
      <xs:enumeration value="verification"/>
      <xs:enumeration value="test"/>
      <xs:enumeration value="task"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="lifecycleStatus">
    <xs:restriction base="xs:string">
      <xs:enumeration value="active"/>
      <xs:enumeration value="deprecated"/>
      <xs:enumeration value="superseded"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="verificationMethod">
    <xs:restriction base="xs:string">
      <xs:enumeration value="test"/>
      <xs:enumeration value="demo"/>
      <xs:enumeration value="analysis"/>
      <xs:enumeration value="inspection"/>
    </xs:restriction>
  </xs:simpleType>

  <!--
    The obligation TYPE vocabulary. It is the authoring method set plus `manual`: the obligation
    validator accepts `manual` where the authoring grammar names the same intent `demo`, and a
    schema narrower than the code would refuse the shipped shape (AUG-134).
  -->
  <xs:simpleType name="obligationType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="test"/>
      <xs:enumeration value="demo"/>
      <xs:enumeration value="analysis"/>
      <xs:enumeration value="inspection"/>
      <xs:enumeration value="manual"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="schemaVersion">
    <xs:restriction base="xs:string">
      <xs:enumeration value="1.0"/>
    </xs:restriction>
  </xs:simpleType>

  <!--
    The digest an approval is bound to (AUG-121): sha256, lower-case hex. A task whose
    `plan-digest` does not match the packet it currently describes is a STALE approval and is
    refused by `spec task-export`; this facet only states the shape. XSD 1.0 has no
    case-insensitivity flag, so the facet pins lower-case and the code checks the same value.
  -->
  <xs:simpleType name="planDigest">
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9a-f]{64}"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Whitespace-separated list of stable IDs, resolved repository-wide. -->
  <xs:simpleType name="idRefList">
    <xs:list itemType="auger:stableId"/>
  </xs:simpleType>

  <!-- Whitespace-separated list of applicability scope tokens. -->
  <xs:simpleType name="scopeList">
    <xs:list itemType="auger:scopeToken"/>
  </xs:simpleType>

  <!--
    One block. `kind` must equal the element name (the validator refuses a mismatch), so a
    selector can filter on `kind` uniformly across mixed element names.
    `verification` is required on <requirement> and <acceptance>; a <verification> block carries
    the same closed set under `method`.

    Every attribute below is one auger.py READS on an authored block. An attribute the code reads
    and this type does not declare makes the grammar incomplete (an editor flags every such
    document; AUG-133), and an attribute the code does NOT read is refused here rather than
    silently ignored — `tests/test_xsd_conformance.py` derives the read set from auger.py's AST and
    asserts it is declared here, so the two cannot drift again.
  -->
  <xs:complexType name="blockType" mixed="true">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element ref="auger:block"/>
      <xs:element ref="auger:include"/>
      <xs:element ref="auger:verification-ref"/>
      <!-- A task's exclusion reasons (AUG-121). It lives in this choice because an XSD 1.0
           extension of a MIXED type cannot introduce a new element particle (the processor
           refuses the whole schema: "the content type of both, the type and its base type, must
           either be 'mixed' or 'element-only'"). The code therefore refuses an <exclusion> outside
           a <task> (`unexpected-exclusion`), so the grammar's tolerance cannot become a silently
           ignored element. -->
      <xs:element ref="auger:exclusion"/>
    </xs:choice>
    <xs:attribute name="id" type="auger:stableId" use="required"/>
    <xs:attribute name="kind" type="auger:blockKind" use="required"/>
    <xs:attribute name="status" type="auger:lifecycleStatus" use="required"/>
    <xs:attribute name="version" type="auger:semanticVersion" use="required"/>
    <xs:attribute name="applies-to" type="auger:scopeList" use="optional"/>
    <xs:attribute name="verification" type="auger:verificationMethod" use="optional"/>
    <xs:attribute name="method" type="auger:verificationMethod" use="optional"/>
    <xs:attribute name="type" type="auger:obligationType" use="optional"/>
    <xs:attribute name="depends-on" type="auger:idRefList" use="optional"/>
    <xs:attribute name="verifies" type="auger:idRefList" use="optional"/>
    <xs:attribute name="refs" type="auger:idRefList" use="optional"/>
    <xs:attribute name="implements" type="auger:idRefList" use="optional"/>
    <xs:attribute name="supersedes" type="auger:idRefList" use="optional"/>
    <!-- AUG-138: the ONE typed edge that resolves OUTSIDE the corpus — a decision RECORD id in a
         DuckBrain namespace named by the caller's decision-namespace flag. The id list is the same
         stable-id shape a block id has (D-014, DER-2), because a record id is a stable identifier
         too; the GRAMMAR cannot say which namespace or whether the row exists, so the executable
         validator resolves it (`unresolved-decision-ref`, `superseded-decision-ref`,
         `decision-ledger-unavailable`) and never expands an assembly closure. -->
    <xs:attribute name="decision-ref" type="auger:idRefList" use="optional"/>
    <!-- Typed test obligation (AUG-123): a runner identifier from auger's own registry, a
         repository-relative tracked path, the test selector, and optional migration evidence.
         These are strings here on purpose: the executable validator resolves and checks them
         (registry membership, tracked file, AST selector, migration/fixture existence), which a
         facet cannot do. The grammar's job is to make the SHAPE expressible. -->
    <xs:attribute name="runner" type="xs:string" use="optional"/>
    <xs:attribute name="selector" type="xs:string" use="optional"/>
    <xs:attribute name="path" type="xs:string" use="optional"/>
    <xs:attribute name="migration" type="xs:string" use="optional"/>
    <xs:attribute name="fixture" type="xs:string" use="optional"/>
    <xs:attribute name="assertions" type="xs:string" use="optional"/>
  </xs:complexType>

  <xs:element name="block" type="auger:blockType" abstract="true"/>

  <xs:element name="section" type="auger:blockType" substitutionGroup="auger:block"/>
  <xs:element name="requirement" type="auger:blockType" substitutionGroup="auger:block"/>
  <xs:element name="acceptance" type="auger:blockType" substitutionGroup="auger:block"/>
  <xs:element name="verification" type="auger:blockType" substitutionGroup="auger:block"/>
  <xs:element name="test" type="auger:blockType" substitutionGroup="auger:block"/>

  <!--
    A TASK block (AUG-121). A task is a small spec for one exact request, so it keeps every block
    attribute and ADDS its scope:

      in-scope        the blocks this task implements (required, by the validator: a task with no
                      scope cannot be dispatched against a contract)
      out-of-scope    the blocks it explicitly does NOT touch
      acceptance      the <acceptance> criteria it is judged on
      acknowledges    the deliberate inclusion of a non-active block
      scope-version   pins the whole scope to one contract version
      plan-digest     the sha256 of the canonical packet this task's approval was granted for

    The reasons for the exclusions live on <exclusion> CHILD elements, not in a parallel attribute
    list: a reason is inseparable from the ref it explains, and a whitespace-separated attribute
    cannot hold prose without an escaping convention nobody would remember. `taskType` extends
    `blockType`, so the task-only attributes cannot appear on any other block kind.
  -->
  <xs:complexType name="taskType">
    <xs:complexContent>
      <xs:extension base="auger:blockType">
        <xs:attribute name="in-scope" type="auger:idRefList" use="optional"/>
        <xs:attribute name="out-of-scope" type="auger:idRefList" use="optional"/>
        <xs:attribute name="acceptance" type="auger:idRefList" use="optional"/>
        <xs:attribute name="acknowledges" type="auger:idRefList" use="optional"/>
        <xs:attribute name="scope-version" type="auger:semanticVersion" use="optional"/>
        <xs:attribute name="plan-digest" type="auger:planDigest" use="optional"/>
        <!-- PLAN MEMBERSHIP (AUG-119). A plan is many tasks with one reviewed version and digest,
             so the task says which plan it belongs to — membership is authored, never inferred
             from a filename or a directory. `plan-version` is the version of the PLAN the task
             belongs to; the builder refuses a plan whose members disagree, because a plan half
             from one review and half from another cannot be approved as a unit. -->
        <xs:attribute name="plan" type="auger:stableId" use="optional"/>
        <xs:attribute name="plan-version" type="auger:semanticVersion" use="optional"/>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:element name="task" type="auger:taskType" substitutionGroup="auger:block"/>

  <!--
    Why one out-of-scope block is excluded. `reason` is prose; the code refuses an empty one
    (`missing-exclusion-reason`) because "out of scope" with no reason is indistinguishable from
    "I forgot", and the reason is what stops the next agent re-litigating the exclusion.
  -->
  <xs:element name="exclusion">
    <xs:complexType>
      <xs:attribute name="ref" type="auger:stableId" use="required"/>
      <xs:attribute name="reason" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>

  <!-- An explicit verification edge as a child of a requirement, beside `verifies=`. -->
  <xs:element name="verification-ref">
    <xs:complexType>
      <xs:attribute name="ref" type="auger:stableId" use="required"/>
    </xs:complexType>
  </xs:element>

  <!--
    Include another authored document at this position. Local repository-relative paths only:
    scheme-bearing, absolute and `..` sources are refused, and an include cycle is refused
    before any fragment is assembled.
  -->
  <xs:element name="include">
    <xs:complexType>
      <xs:attribute name="src" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="spec">
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element ref="auger:block"/>
        <xs:element ref="auger:include"/>
      </xs:choice>
      <xs:attribute name="id" type="auger:stableId" use="required"/>
      <xs:attribute name="version" type="auger:semanticVersion" use="required"/>
      <xs:attribute name="schema-version" type="auger:schemaVersion" use="required"/>
    </xs:complexType>
  </xs:element>

</xs:schema>
