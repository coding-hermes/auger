<?xml version="1.0" encoding="UTF-8"?>
<!--
  AUG-143 fixture: a block that CLAIMS rollback support and names no test that proves it.

  `rollback="tracked-test"` is a claim that rolling this change back is exercised by a tracked
  test. A claim with no `runner`/`path`/`selector` pointer is exactly the decoration the row
  exists to refuse: a reader who trusted it would believe a rollback path had been proved. The
  refusal is `rollback-undeclared-proof`, naming this document and the block.
-->
<spec xmlns="urn:auger:spec:1" id="AUGER-SPEC-ROLLBACK-CLAIM" version="1.0.0"
      schema-version="1.0">
  <verification id="AUG-VER-ROLLBACK-CLAIM-1" kind="verification" status="active"
                version="1.0.0" applies-to="auger.spec.rollback" method="test"
                rollback="tracked-test">
    Rollback is exercised by a test — but which test is never said, so nothing can be resolved.
  </verification>
</spec>
