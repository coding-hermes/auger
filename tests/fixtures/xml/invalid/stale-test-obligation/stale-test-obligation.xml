<?xml version="1.0" encoding="UTF-8"?>
<!--
  AUG-132 fixture: a corpus whose verification block names a test path that is not in
  the repository.

  Everything except the obligation is valid: namespaced root, schema version, stable ids,
  typed kind/status/version metadata, a resolving `verifies` edge. `spec check` always
  refused it; `spec validate` counted 1 document / 2 blocks / 1 reference, printed "ok"
  and exited 0, so the verdict depended on which verb a caller happened to type.
-->
<spec xmlns="urn:auger:spec:1" id="AUGER-STALE-OBLIGATION" version="1.0.0" schema-version="1.0">

  <requirement id="AUG-REQ-STALE-1" kind="requirement" status="active" version="1.0.0"
               applies-to="auger.spec" verification="test">
    A requirement whose verification plan names a test path that is not a tracked file.
  </requirement>

  <verification id="AUG-VER-STALE-1" kind="verification" status="active" version="1.0.0"
                applies-to="auger.spec" method="test" verifies="AUG-REQ-STALE-1"
                runner="pytest" path="tests/does-not-exist.py"
                selector="test_this_selector_does_not_exist" />

</spec>
