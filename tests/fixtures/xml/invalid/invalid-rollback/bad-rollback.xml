<?xml version="1.0" encoding="UTF-8"?>
<!--
  AUG-143 fixture: a rollback declaration outside the CLOSED vocabulary.

  `rollback` is `unsupported` or `tracked-test` — nothing else. A free-text value ("best-effort")
  would read to a consumer as a fourth state nobody defined, and the point of a closed set is that
  a reader can decide without guessing. The refusal must be the CODE's typed diagnostic
  (`invalid-rollback-declaration`), not the grammar's generic `schema-invalid`: the code's rules run
  first (AUG-125 ordering), so the author sees the attribute and the enum.
-->
<spec xmlns="urn:auger:spec:1" id="AUGER-SPEC-ROLLBACK-BAD" version="1.0.0"
      schema-version="1.0">
  <verification id="AUG-VER-ROLLBACK-BAD-1" kind="verification" status="active" version="1.0.0"
                applies-to="auger.spec.rollback" method="test" rollback="best-effort">
    A declaration of rollback support is a closed value, not a sentence.
  </verification>
</spec>
