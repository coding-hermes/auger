<?xml version="1.0" encoding="UTF-8"?>
<!--
  AUG-150 negative direction: a block that declares a NON-test method must not be dragged
  through the test-obligation checks.

  Every block here declares a method and NO runner/path/selector pointer, so there is no test
  location to resolve. The obligation pass must accept all four, including `method="test"` —
  a block that only states a METHOD is a verification PLAN, which is the shape
  `docs/XML-SPEC-SCHEMA.md` documents as "a method, not a location".

  This fixture is what keeps a tightening from over-blocking: if a future change starts
  demanding a tracked test reference from a method-only block, this corpus goes red.
-->
<spec xmlns="urn:auger:spec:1" id="AUGER-SPEC-METHODS" version="1.0.0"
      schema-version="1.0">
  <requirement id="AUG-REQ-METHODS-1" kind="requirement" status="active" version="1.0.0"
               applies-to="auger.spec.obligation" verification="inspection">
    A declaration of HOW a requirement is verified is not a claim about WHERE a test lives, so
    every method in the closed set is accepted without a runner, a path or a selector.
  </requirement>

  <verification id="AUG-VER-METHODS-TEST" kind="verification" status="active" version="1.0.0"
                applies-to="auger.spec.obligation" method="test"
                verifies="AUG-REQ-METHODS-1">
    The test method, declared without a location: this is a plan, and the validator must not
    demand that a plan name a tracked file.
  </verification>

  <verification id="AUG-VER-METHODS-DEMO" kind="verification" status="active" version="1.0.0"
                applies-to="auger.spec.obligation" method="demo"
                verifies="AUG-REQ-METHODS-1">
    Demonstrated to a person, never executed by a harness.
  </verification>

  <verification id="AUG-VER-METHODS-ANALYSIS" kind="verification" status="active"
                version="1.0.0" applies-to="auger.spec.obligation" method="analysis"
                verifies="AUG-REQ-METHODS-1">
    Argued from measured evidence rather than replayed by a test.
  </verification>

  <verification id="AUG-VER-METHODS-INSPECTION" kind="verification" status="active"
                version="1.0.0" applies-to="auger.spec.obligation" method="inspection"
                verifies="AUG-REQ-METHODS-1">
    Read and signed off by a reviewer; there is nothing for a runner to execute.
  </verification>
</spec>
