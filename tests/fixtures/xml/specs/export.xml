<?xml version="1.0" encoding="UTF-8"?>
<!--
  Export contract document. It splices the shared fragment and adds its own requirement, acceptance
  criterion and verification plan. Selection golden:
  tests/fixtures/xml/expected/assembly-active-auger-export.md
-->
<spec xmlns="urn:auger:spec:1" id="AUGER-EXPORT" version="1.0.0" schema-version="1.0">

  <include src="shared.xml"/>

  <section id="AUGER-EXPORT-SURFACE" kind="section" status="active" version="1.0.0"
           applies-to="auger.export">
    The Markdown export surface: one deterministic, read-only document per namespace.
  </section>

  <requirement id="AUG-REQ-014" kind="requirement" status="active" version="1.0.0"
               applies-to="auger.export" verification="test"
               depends-on="AUG-SHARED-DETERMINISM">
    The default `auger export` output remains deterministic and read-only.
  </requirement>

  <acceptance id="AUG-AC-014-1" kind="acceptance" status="active" version="1.0.0"
              applies-to="auger.export" verification="test" verifies="AUG-REQ-014">
    Running the export twice over the same stored rows produces byte-identical output.
  </acceptance>

  <verification id="AUG-VER-014-1" kind="verification" status="active" version="1.0.0"
                applies-to="auger.export" method="test" verifies="AUG-REQ-014">
    Golden Markdown fixture compared against render_export output, twice, byte for byte.
  </verification>

  <requirement id="AUG-REQ-020" kind="requirement" status="active" version="1.0.0"
               applies-to="auger.recall" verification="test">
    Decoy: recall semantics, out of every export-scoped selection.
  </requirement>

  <requirement id="AUG-REQ-021" kind="requirement" status="deprecated" version="0.9.0"
               applies-to="auger.export" verification="test">
    Retired export requirement: kept for traceability, excluded by a status=active selector.
  </requirement>

</spec>
