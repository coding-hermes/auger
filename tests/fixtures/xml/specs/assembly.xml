<?xml version="1.0" encoding="UTF-8"?>
<!--
  Assembly contract document. It reuses the shared fragment by explicit ID reference (no include):
  AUG-SHARED-DETERMINISM through `depends-on`, and AUG-SHARED-CITATION only through `refs`, which
  is navigable but NEVER expands a bundle — that distinction is asserted by the tests.
-->
<spec xmlns="urn:auger:spec:1" id="AUGER-ASSEMBLY" version="1.0.0" schema-version="1.0">

  <requirement id="AUG-REQ-030" kind="requirement" status="active" version="2.0.0"
               applies-to="auger.spec" verification="analysis"
               depends-on="AUG-SHARED-DETERMINISM" refs="AUG-SHARED-CITATION">
    Assembly selects blocks by stable ID and typed attributes and emits only the selection plus its
    explicit dependency closure.
  </requirement>

  <acceptance id="AUG-AC-030-1" kind="acceptance" status="active" version="2.0.0"
              applies-to="auger.spec" verification="test" verifies="AUG-REQ-030">
    A selection over two files emits the matched blocks and their declared dependencies in corpus
    order, with a citation per block.
  </acceptance>

</spec>
