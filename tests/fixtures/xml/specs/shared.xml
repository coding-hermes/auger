<?xml version="1.0" encoding="UTF-8"?>
<!--
  Shared fragment: blocks authored ONCE here and reused from several documents by explicit stable
  ID (AUG-118 AC-2/R4). export.xml splices this file with <include>; assembly.xml references these
  blocks by ID without including them, so the two documents cannot drift into stale copies.
-->
<spec xmlns="urn:auger:spec:1" id="AUGER-SHARED" version="1.0.0" schema-version="1.0">

  <requirement id="AUG-SHARED-DETERMINISM" kind="requirement" status="active" version="1.1.0"
               applies-to="auger.export auger.spec" verification="analysis">
    Identical inputs shall produce byte-identical assembled output; assembly reads the corpus and
    writes nothing back to it.
  </requirement>

  <requirement id="AUG-SHARED-CITATION" kind="requirement" status="active" version="1.0.0"
               applies-to="auger.spec" verification="inspection">
    Every assembled block shall cite the repository-relative source file and stable ID it was
    authored in.
  </requirement>

</spec>
