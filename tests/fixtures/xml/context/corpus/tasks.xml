<spec xmlns="urn:auger:spec:1" id="SG7-CONTEXT" version="1.0.0" schema-version="1.0">
  <requirement id="SG7-REQ-1" kind="requirement" status="active" version="1.0.0"
               applies-to="auger.export" verification="test" verifies="SG7-VER-1">
    The exporter writes one canonical board row per task.
  </requirement>
  <verification id="SG7-VER-1" kind="verification" status="active" version="1.0.0"
                applies-to="auger.export" method="test">The row is read back and compared.</verification>
  <acceptance id="SG7-AC-1" kind="acceptance" status="active" version="1.0.0"
              applies-to="auger.export" verification="test" verifies="SG7-REQ-1">
    The canonical row records the in-scope and excluded ids.
  </acceptance>
  <requirement id="SG7-REQ-9" kind="requirement" status="active" version="1.0.0"
               verification="inspection">A later wave owns the migration path.</requirement>
  <task id="SG7-TASK-1" kind="task" status="active" version="1.0.0"
        applies-to="auger.export" verification="test"
        in-scope="SG7-REQ-1" acceptance="SG7-AC-1" out-of-scope="SG7-REQ-9">
    Export this task as one canonical board row.
    <exclusion ref="SG7-REQ-9" reason="owned by a later wave"/>
  </task>
</spec>
