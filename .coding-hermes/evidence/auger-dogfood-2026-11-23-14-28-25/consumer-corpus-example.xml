<spec xmlns="urn:auger:spec:1" id="TT-TRACKER" version="1.0.0" schema-version="1.0">
  <requirement id="TT-REQ-1" kind="requirement" status="active" version="1.0.0"
               applies-to="tracker.add" verification="test" verifies="TT-VER-1">
    Adding a task stores it with a unique id and the text as given.
  </requirement>
  <verification id="TT-VER-1" kind="verification" status="active" version="1.0.0"
                applies-to="tracker.add" method="test" type="test" runner="pytest"
                path="tests/test_tracker.py" selector="test_add_stores_unique_id"
                assertions="two adds produce two distinct ids" />
  <acceptance id="TT-AC-1" kind="acceptance" status="active" version="1.0.0"
              applies-to="tracker.add" verification="test" verifies="TT-REQ-1">
    add('buy milk') twice returns two distinct task ids and both are retrievable.
  </acceptance>
  <requirement id="TT-REQ-9" kind="requirement" status="active" version="1.0.0"
               verification="inspection">
    A later wave owns the search feature.
  </requirement>
  <task id="TT-TASK-1" kind="task" status="active" version="1.0.0"
        applies-to="tracker.add" verification="test"
        plan="TT-PLAN" plan-version="1.0.0"
        in-scope="TT-REQ-1" acceptance="TT-AC-1" out-of-scope="TT-REQ-9">
    Implement the add verb of the scratch tracker.
    <exclusion ref="TT-REQ-9" reason="owned by the search wave"/>
  </task>
</spec>
