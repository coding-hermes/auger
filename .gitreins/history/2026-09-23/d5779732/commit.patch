+ {"id": "AUG-030", "title": "[P2] re-answering a question leaves the superseded decision ACTIVE: the configuration self-contradicts and nothing names it \u2014 JEV itself judged the resulting active config BAD at noul 0.36", "status": "pending", "priority": "P2", "type": null, "created_at": "2026-09-23T04:45:00+00:00", "created_by": null, "description": null, "acceptance_criteria": "Dogfood 2026-09-23: answering the same contract area repeatedly (mccli D-003 v2 envelope, D-004 v3, D-005 v4, D-006 v5; retention D-007 30d, D-008 confirmed, D-010 60d) leaves every decision 'decided' with its chosen option ACTIVE \u2014 dump renders five envelope variants and three retention variants as THE configuration simultaneously. `verdict --ask-jev` on that active config returned BAD at noul 0.36 (V-000001) and 0.14 (V-000002) \u2014 the model SAW the incoherence the engine never flags. The record has no supersession relation: decision rows do not reference what they replace, options stay active, status is undisturbed. ACCEPTANCE: (a) a decision whose domain+question overlap an existing decided decision is flagged at answer time ('supersedes D-007? pass --supersedes D-007 to record it'); (b) --supersedes writes an edge (kind 'supersedes', decision->decision) and flips the old decision's status to 'superseded' (facet rows carrying the reason); (c) dump renders superseded decisions as such and excludes them from ACTIVE CONFIGURATION; (d) status names unresolved supersession chains.", "source": "dogfood 2026-09-23 (graph/bundles/verdict surface)", "review_notes": null, "capability_tags": ["dogfood", "bundles", "engine", "model"], "complexity": 3, "attempts": 0, "blocked_reason": null, "blocked_since": null, "blocks": [], "depends_on": [], "dispatched_at": null, "exit_code": null, "fallback_model": null, "fallback_provider": null, "files_changed": [], "foreman_note": "Jev verdict cost data point: the bad-config call cost $0.00010. The fix is a new edge kind + a status value + dump/status rendering; no model calls needed.", "guard_result": null, "ci_result": null, "commit_hash": null, "completed_at": null, "lines_added": null, "lines_removed": null, "perpetual": null, "primary_model": null, "primary_provider": null, "reasoning": null, "updated_at": "2026-09-23T04:45:00+00:00", "worker_status": null, "worker_summary": null}
