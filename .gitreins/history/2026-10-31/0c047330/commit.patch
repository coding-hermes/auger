+        action="append",
+        choices=SPEC_STATUSES,
+        help="select this lifecycle status",
+    )
+    parser.add_argument(
+        "--version",
+        action="append",
+        metavar="X.Y.Z",
+        help="select this block version attribute",
+    )
+
