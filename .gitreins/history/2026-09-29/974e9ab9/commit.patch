+            "-n",
+            ns,
+            "answer",
+            "--id",
+            "D-058",
+            "--chosen",
+            "chosen option",
+            "--option",
+            "chosen option",
+            "--option",
+            "only rejected",
+            "--why-not",
+            "first reason",
+            "--why-not",
+            "second reason",
+            "--why-not",
+            "third reason",
+            "--confidence",
+            "0.8",
+        ]
+    )
+    assert rc != 0
+    assert "--why-not" in message
+    assert out == ""
+    assert rows(ns, "decision", "id=eq.D-058") == []
+
