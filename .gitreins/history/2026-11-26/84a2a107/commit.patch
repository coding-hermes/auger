+    measured shape pairs; anything else re-raises.
     """
     buf = io.StringIO()
     with contextlib.redirect_stdout(buf):
@@ -108,6 +152,13 @@ def run_cli(argv: list[str]) -> tuple[int, str]:
             pytest.skip(
